# ============================================
# VARIÁVEIS DE AMBIENTE NETLIFY - OBRIGATÓRIAS
# ============================================

# COPIE E COLE NO NETLIFY:
# Site configuration → Environment variables → Add a variable

# 1. Nome do servidor Azure SQL
AZURE_SQL_SERVER = srv-db-cxtce.database.windows.net

# 2. Nome do banco de dados
AZURE_SQL_DATABASE = db-ematech

# 3. Usuário administrador
AZURE_SQL_USER = admin.dba

# 4. Senha do banco (ATENÇÃO: caso sensitive)
AZURE_SQL_PASSWORD = A57458974x23*

# ============================================
# IMPORTANTE:
# ============================================
# - Não use aspas nos valores
# - Copie exatamente como está
# - A senha tem maiúscula "A" e caracteres especiais
# - Após adicionar, faça REDEPLOY do site
# ============================================

# ============================================
# VERIFICAR SE ESTÁ CORRETO:
# ============================================
# Após configurar, acesse:
# https://app.netlify.com/sites/SEU_SITE/deploys
# 
# Clique no último deploy → Deploy log
# Procure por erros relacionados a SQL
# ============================================
